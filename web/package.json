{
  "name": "nema-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test": "tsx scripts/check-crypto.ts",
    "live:smoke": "tsx scripts/smoke.ts",
    "live:demo-round": "tsx scripts/demo-round.ts",
    "live:close-rounds": "tsx scripts/close-rounds.ts",
    "live:check-attest": "tsx scripts/check-attest.ts",
    "live:enclave-source": "tsx scripts/enclave-source.ts",
    "live:deploy": "pnpm dlx vercel@58.4.4 build --prod && pnpm dlx vercel@58.4.4 deploy --prebuilt --prod",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/here-wallet": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@near-wallet-selector/modal-ui": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "buffer": "6.0.3",
    "eciesjs": "0.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5"
  }
}
