{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/outlayer/testnet/jobs", "destination": "https://testnet-api.outlayer.ai/public/jobs" },
    { "source": "/outlayer/mainnet/jobs", "destination": "https://api.outlayer.ai/public/jobs" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
